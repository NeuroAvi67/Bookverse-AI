# ==============================================================================
# BOOKVERSE AI — Environment Configuration Template
# ==============================================================================

# Server Listening Port (Default: 5000)
PORT=5000

# Google Gemini API Key (Google AI Studio: https://aistudio.google.com/)
# Used for: Deep Research Dossiers, Multi-tier Summaries, AI Book Assistant
GEMINI_API_KEY=

# OpenAI API Key (Optional model switcher: https://platform.openai.com/)
OPENAI_API_KEY=

# Supabase Cloud Database & Auth (Optional - Local storage is active by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Search Provider (Optional - Open academic search is built-in)
WEB_SEARCH_API_KEY=
